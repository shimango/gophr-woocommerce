{
  "name": "shimango/gophr-woocommerce",
  "description": "WooCommerce integration for Gophr same-day delivery",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1",
    "shimango/gophr": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "yoast/phpunit-polyfills": "^1.0",
    "mockery/mockery": "^1.5",
    "wp-phpunit/wp-phpunit": "^6.1",
    "squizlabs/php_codesniffer": "^3.7",
    "wp-coding-standards/wpcs": "^3.0",
    "phpstan/phpstan": "^1.10",
    "phpcompatibility/php-compatibility": "^9.3"
  },
  "autoload": {
    "psr-4": {
      "Gophr\\Woocommerce\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Gophr\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite Unit",
    "test:integration": "phpunit --testsuite Integration",
    "test:coverage": "phpunit --coverage-html tests/coverage/html --coverage-clover tests/coverage/clover.xml",
    "test:watch": "phpunit-watcher watch",
    "phpcs": "phpcs --standard=WordPress src/",
    "phpcbf": "phpcbf --standard=WordPress src/",
    "phpstan": "phpstan analyse src/ --level=5",
    "phpstan:baseline": "phpstan analyse src/ --level=5 --generate-baseline",
    "lint": [
      "@phpcs",
      "@phpstan"
    ],
    "fix": "@phpcbf",
    "install-wp-tests": [
      "bash bin/install-wp-tests.sh wordpress_test root '' localhost latest"
    ],
    "install-codestandards": [
      "Dealerdirect\\Composer\\Plugin\\Installers\\PHPCodeSniffer\\Plugin::run"
    ]
  },
  "scripts-descriptions": {
    "test": "Run all PHPUnit tests",
    "test:unit": "Run unit tests only",
    "test:integration": "Run integration tests only",
    "test:coverage": "Generate code coverage report",
    "phpcs": "Check code against WordPress coding standards",
    "phpcbf": "Automatically fix coding standard violations",
    "phpstan": "Run static analysis",
    "lint": "Run all linting tools",
    "fix": "Automatically fix code issues",
    "install-wp-tests": "Install WordPress test suite"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}