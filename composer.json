{
  "name": "shimango/gophr-woocommerce",
  "description": "Gophr plugin for Woocommerce",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "autoload": {
    "psr-4": {
      "Gophr\\Woocommerce\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Gophr\\Woocommerce\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable"
}