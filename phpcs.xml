<?xml version="1.0"?>
<!-- phpcs.xml -->
<ruleset name="Gophr WooCommerce Plugin">
    <description>WordPress Coding Standards for Gophr WooCommerce Plugin</description>

    <!-- What to scan -->
    <file>./src</file>
    <file>./gophr-woocommerce.php</file>

    <!-- Exclude patterns -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/assets/*</exclude-pattern>

    <!-- How to scan -->
    <arg value="sp"/> <!-- Show sniff and progress -->
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>

    <!-- Rules: WordPress Coding Standards -->
    <rule ref="WordPress">
        <!-- Allow short array syntax -->
        <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>

        <!-- Allow Yoda conditions to be optional -->
        <exclude name="WordPress.PHP.YodaConditions"/>

        <!-- Modern PHP -->
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>

        <!-- We use namespaces -->
        <exclude name="WordPress.NamingConventions.PrefixAllGlobals"/>
    </rule>

    <!-- Check for PHP cross-version compatibility -->
    <config name="testVersion" value="8.1-"/>
    <rule ref="PHPCompatibility"/>

    <!-- WordPress-Extra -->
    <rule ref="WordPress-Extra">
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
    </rule>

    <!-- WordPress-Docs -->
    <rule ref="WordPress-Docs"/>

    <!-- Verify that everything in the global namespace is prefixed -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="gophr"/>
                <element value="Gophr"/>
            </property>
        </properties>
    </rule>

    <!-- Text domain -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="gophr-same-day"/>
            </property>
        </properties>
    </rule>

    <!-- Minimum WordPress version -->
    <config name="minimum_supported_wp_version" value="6.0"/>

    <!-- WordPress Nonce verification -->
    <rule ref="WordPress.Security.NonceVerification"/>

    <!-- Escape output -->
    <rule ref="WordPress.Security.EscapeOutput"/>

    <!-- Validate and sanitize input -->
    <rule ref="WordPress.Security.ValidatedSanitizedInput"/>
</ruleset>